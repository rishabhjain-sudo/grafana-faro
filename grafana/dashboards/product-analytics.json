    {
      "id": 5,
      "type": "stat",
      "title": "Conversion rate",
      "description": "Sessions with a purchase \u00f7 all sessions.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (session_id) (count_over_time({source=\"faro\", app_name=\"$app\", app_env=\"$env\", kind=\"event\"} | logfmt | event_name=\"purchase\" [$__range]))) / count(sum by (session_id) (count_over_time({source=\"faro\", app_name=\"$app\", app_env=\"$env\", kind=\"event\"} | logfmt [$__range]))) * 100",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
