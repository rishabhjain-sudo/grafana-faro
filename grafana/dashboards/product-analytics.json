{
  "uid": "faro-product-analytics",
  "title": "Product Analytics \u00b7 Grafana Faro",
  "description": "Frontend product analytics from Grafana Faro events stored in Loki.",
  "tags": [
    "faro",
    "product-analytics",
    "poc"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "type": 1,
          "label": "app_name",
          "stream": "{source=\"faro\"}",
          "refId": "app"
        },
        "definition": "label_values({source=\"faro\"}, app_name)",
        "current": {
          "text": "demo-shop",
          "value": "demo-shop"
        }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "refresh": 2,
        "query": {
          "type": 1,
          "label": "app_env",
          "stream": "{source=\"faro\", app_name=\"$app\"}",
          "refId": "env"
        },
        "definition": "label_values({source=\"faro\", app_name=\"$app\"}, app_env)",
        "current": {
          "text": "poc",
          "value": "poc"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique users",
      "description": "Distinct user_id values with at least one event in the time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (user_id) (count_over_time({source=\"faro\", app_name=\"$app\", app_env=\"$env\", kind=\"event\"} | logfmt [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
